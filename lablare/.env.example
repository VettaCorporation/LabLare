# =============================================================================
# LabLare - variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite .env (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (obrigatório)
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://root:SUA_SENHA_AQUI@localhost:3306/lablare"

# -----------------------------------------------------------------------------
# NextAuth (obrigatório)
# -----------------------------------------------------------------------------
# Gere com: openssl rand -base64 32  (Linux/Mac)
# ou: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))  (PowerShell)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# SMTP (opcional em dev — sem isso, reset de senha e email de cadastro de
# paciente falham silenciosamente, mas o app continua funcional)
# -----------------------------------------------------------------------------
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM_NAME="LabLare"
EMAIL_FROM_ADDRESS="noreply@lablare.com.br"

# -----------------------------------------------------------------------------
# Resend (apenas para o formulário público de contato em /contato)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Seed (opcional — sem isso, usa fallback "TrocarSenha@2026" + primeiro_login=true)
# -----------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=""
SEED_RECEP_PASSWORD=""

# -----------------------------------------------------------------------------
# Logging (opcional — default: info em prod, debug em dev)
# -----------------------------------------------------------------------------
LOG_LEVEL="debug"
